NODE_ENV=development

APP_NAME=Lando
APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=localhost

DATABASE_URL=postgresql://lando:lando@localhost:5432/lando?schema=public
# Docker Compose uses this password for PostgreSQL. Use only ASCII letters and
# numbers: the same raw value is also inserted into the container DATABASE_URL.
# Compose replaces its host with `postgres`.
POSTGRES_PASSWORD=
AUTH_SECRET=
ENCRYPTION_KEY=

# Local Compose publishes Caddy on http://localhost:3000. In production set
# LANDO_IMAGE_TARGET=runner, CADDY_SITE_ADDRESS to the public hostname and
# ports to 80/443.
LANDO_RUNTIME_ENV=development
LANDO_IMAGE_TARGET=development
CADDY_SITE_ADDRESS=http://localhost
LANDO_HTTP_PORT=3000
LANDO_HTTPS_PORT=3443
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

LLM_PROVIDER=mock
# Готовый ключ авторизации из кабинета GigaChat API. Не отправляйте его в чат
# и не добавляйте в Git. Для физлица scope должен оставаться PERS.
GIGACHAT_CREDENTIALS=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
OPENAI_API_KEY=
YANDEX_CLOUD_API_KEY=

STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

BILLING_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

REGRU_API_ENABLED=false
REGRU_API_USERNAME=
REGRU_API_PASSWORD=

TELEGRAM_ENCRYPTION_KEY=
